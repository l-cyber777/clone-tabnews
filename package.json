{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Um projeto para treinar programação, aprendendo de ponta à ponta como criar um projeto.",
  "homepage": "https://github.com/l-cyber777/clone-tabnews#readme",
  "bugs": {
    "url": "https://github.com/l-cyber777/clone-tabnews/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l-cyber777/clone-tabnews.git"
  },
  "license": "MIT",
  "author": "l-cyber",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/services:wait:postgres.js",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "test": "npm run services:up && npm run services:wait:database && concurrently -n next,jest --hide next -k -s command-jest 'next dev' 'jest --runInBand'",
    "test:watch": "jest --watchAll --runInBand",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "next": "16.2.11",
    "node-pg-migrate": "9.0.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "9.39.5",
    "commitizen": "^4.3.2",
    "concurrently": "10.0.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "husky": "^9.1.7",
    "jest": "30.4.2",
    "prettier": "3.9.6"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
